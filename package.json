    "doctor": "node dist/src/cli.js doctor"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "mermaid-isomorphic": "3.1.0",
    "pg": "8.23.1",
    "playwright": "1.65.1",
    "redis": "6.4.0",
    "swagger-ui-dist": "5.36.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.15.6",
    "typescript": "7.0.2"
  }
