{
  "name": "lv24-diagram",
  "version": "0.2.1",
  "mcpName": "io.github.LevapVeeskela/lv24-diagram",
  "description": "Architecture-as-code MCP: Mermaid render/lint, ER diagrams from a live schema, repository architecture scan, draw.io bridge",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "lv24-diagram": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "files": [
    "dist",
    "!dist/test",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json",
    "diagram.config.schema.json"
  ],
  "keywords": [
    "mcp",
    "mermaid",
    "drawio",
    "architecture",
    "er-diagram",
    "postgres",
    "c4"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LevapVeeskela/lv24-diagram.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
